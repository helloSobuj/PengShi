# ========================================================================
# Shared environment for the docker-compose self-hosted stack AND
# convenience for local dev (copy → .env in each subfolder if you prefer).
# ========================================================================

# ---- LiveKit Cloud (REQUIRED) ----------------------------------------
# Create a free project at https://cloud.livekit.io → copy these values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=AP................................
LIVEKIT_API_SECRET=

# ---- Agent -----------------------------------------------------------
AGENT_NAME=echo-agent

# inference | byok | openrouter
MODEL_MODE=inference
INFERENCE_TTS_VOICE=Ashley

# Only needed when MODEL_MODE=byok:
# OPENAI_API_KEY=
# OPENAI_LLM_MODEL=gpt-4.1-mini
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# CARTESIA_TTS_MODEL=sonic-3
# CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Only needed when VISION_ENABLED=true & using OpenRouter for Gemini vision:
VISION_ENABLED=true
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Echo Voice Agent

# Optional: Tavily web search key (or set via admin panel on local dev).
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ---- Persistence & RAG -----------------------------------------------
# Keep both false unless you specifically want to strip these features.
DB_DISABLED=false
RAG_DISABLED=false

RAG_MODEL=BAAI/bge-m3
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
CHROMA_COLLECTION=echo_knowledge_base

# Optional: MCP servers JSON array (also readable from /app/data/mcp_servers.json)
# MCP_SERVERS=[{"id":"example","name":"Example","url":"https://example.com/sse","enabled":true,"headers":{}}]

# ---- Web UI ----------------------------------------------------------
# Set this to `inference`, `byok`, or `openrouter` — drives display in the
# Settings panel. The actual authoritative value is MODEL_MODE above.
NEXT_PUBLIC_MODEL_MODE=inference

# Optional: set these endpoints if you run the agent's HTTP API separately.
# Otherwise the web container shares AGENT_DATA_DIR with the agent container
# and drives history/KB via the shared SQLite file directly.
# AGENT_HISTORY_ENDPOINT=http://agent:8080
# AGENT_KB_ENDPOINT=http://agent:8080
# KB_UPLOAD_DIR=/app/agent-data/rag/uploads

# Admin password (change this on any internet-exposed deploy).
ADMIN_PASSWORD=change-me
AGENT_CONFIG_READONLY=false

# en | zh — Next.js default locale for first-time visitors.
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# ---- Networking ------------------------------------------------------
# Host port that exposes the Next.js UI.
WEB_PORT=3000

# WARNING: do NOT set to true on a public host. `true` lets anyone who
# reaches the web UI get a LiveKit token without authentication.
ALLOW_PUBLIC_TOKEN=false

# Optional: LiveKit Cloud sandbox token server
# NEXT_PUBLIC_USE_SANDBOX=true
# NEXT_PUBLIC_SANDBOX_ID=
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
# SANDBOX_ID=
