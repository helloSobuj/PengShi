LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Model mode:
#   inference  — LiveKit Inference STT/LLM/TTS (default)
#   byok       — Deepgram + OpenAI + Cartesia with your own keys
#   openrouter — LiveKit Inference STT/TTS + OpenRouter LLM (Gemini vision, etc.)
# If OPENROUTER_API_KEY is set and VISION_ENABLED=true, mode auto-switches to openrouter.
MODEL_MODE=inference

# Optional: override inference TTS voice (default Ashley)
# INFERENCE_TTS_VOICE=Ashley

# --- Required only when MODEL_MODE=byok ---
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# OPENAI_LLM_MODEL=gpt-4.1-mini
# CARTESIA_TTS_MODEL=sonic-3
# CARTESIA_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# --- Vision via OpenRouter (Gemini) — no Google API key needed ---
VISION_ENABLED=true
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_APP_NAME=Echo Voice Agent

# --- Optional: Tavily web search API key ---
# Takes precedence over the config file value (agent/data/api_config.json)
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# --- Optional: admin-default MCP servers (JSON array) ---
# Also readable from agent/data/mcp_servers.json when this env is unset.
# MCP_SERVERS=[{"id":"example","name":"Example","url":"https://example.com/sse","enabled":true,"headers":{}}]

# --- Persistence / SQLite ---
# Disable SQLite entirely (falls back to legacy notes.json + no chat history / RAG registry)
# DB_DISABLED=false

# --- RAG / Knowledge Base ---
# Disable RAG tool and embedding entirely (knowledge_docs can still register on web side)
# RAG_DISABLED=false

# Embedding model for vector search. BAAI/bge-m3 is multilingual and handles EN + 中文 well.
# RAG_MODEL=BAAI/bge-m3
# Number of top-k snippets returned by rag_search
# RAG_TOP_K=4
# Chunking parameters for ingest
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# Chroma collection name
# CHROMA_COLLECTION=echo_knowledge_base
