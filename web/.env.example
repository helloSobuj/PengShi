# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=<your_api_key>
LIVEKIT_API_SECRET=<your_api_secret>
LIVEKIT_URL=wss://<project-subdomain>.livekit.cloud

# Agent dispatch — must match agent_name in agent/src/agent.py
AGENT_NAME=echo-agent

# Display-only indicator for the Settings panel (agent MODEL_MODE is authoritative)
NEXT_PUBLIC_MODEL_MODE=inference

# Enable camera + screen share controls in the Agents UI
# (agent must also have VISION_ENABLED=true and a vision-capable LLM)

# Personal production: allow /api/token without user auth (do NOT use for public multi-user apps)
# ALLOW_PUBLIC_TOKEN=true

# Optional: use LiveKit Cloud sandbox token server instead of /api/token
# NEXT_PUBLIC_USE_SANDBOX=true
# NEXT_PUBLIC_SANDBOX_ID=
# NEXT_PUBLIC_CONN_DETAILS_ENDPOINT=
# SANDBOX_ID=

# Internally used environment variables
NEXT_PUBLIC_APP_CONFIG_ENDPOINT=

# --- i18n ---
# Default locale for the app (en | zh)
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# --- History / SQLite
# URL of the agent's HTTP API exposing /history/sessions and /history/sessions/:id endpoints
# (optional if using the local AGENT_DATA_DIR fallback below, local read instead)
AGENT_HISTORY_ENDPOINT=http://localhost:8080

# Local agent/data directory, used to read echo.sqlite3 directly when AGENT_HISTORY_ENDPOINT is
# not set (requires Node 22+ with the built-in node:sqlite module)
AGENT_DATA_DIR=../agent/data

# --- Knowledge Base / RAG ---
# URL of the agent's HTTP API exposing /kb/status, /kb/ingest/*, /kb/docs/:id
# If unset, the web server will register docs directly in the SQLite knowledge_docs table
# and save plain text/PDF uploads to agent/data/rag/uploads/ for the Python process to embed.
AGENT_KB_ENDPOINT=http://localhost:8080

# --- Admin Panel ---
# Required: password for the /admin panel
# ADMIN_PASSWORD=change-me

# Optional: path to the agent API config JSON file
# Defaults to ../agent/data/api_config.json relative to the web root
# AGENT_CONFIG_PATH=/absolute/path/to/agent/data/api_config.json
